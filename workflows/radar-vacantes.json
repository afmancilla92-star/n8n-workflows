    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const a = $json.attributes ?? {};\n\nif (a.remote !== true) return null;\n\nconst paises = a.countries ?? [];\nconst bloqueado = paises.length > 0 &&\n  !paises.some(p => ['Colombia', 'Latin America', 'Remote'].includes(p));\nif (bloqueado) return null;\n\nconst descripcion = (a.description ?? '')\n  .replace(/<[^>]*>/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .slice(0, 2500);\n\nreturn {\n  json: {\n    id: String($json.id),\n    titulo: a.title ?? '',\n    empresa: a.company?.data?.attributes?.name ?? 'desconocida',\n    url: $json.links?.public_url ?? '',\n    paises: paises.join(', ') || 'no especificado',\n    postulaciones: a.applications_count ?? 0,\n    descripcion: descripcion\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "49e91bf8-b8fe-4820-b602-8e2fd01b5cf8",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: `Eres un evaluador de compatibilidad laboral. PERFIL DEL CANDIDATO: 13 anios en logistica de exportacion, inventarios y comercio exterior; cumplimiento BASC/OEA; SAP. Construye automatizaciones con n8n, agentes con Claude Code y MCP, apps en Next.js/TypeScript desplegadas en Vercel, scripts en Python. Ingles B2. Reside en Colombia, requiere 100% remoto. VACANTE: Cargo: ${$json.titulo}. Empresa: ${$json.empresa}. Paises: ${$json.paises}. Descripcion: ${$json.descripcion}. Responde UNICAMENTE con un objeto JSON valido, sin markdown ni texto adicional, con exactamente estas tres claves: puntaje (numero entero de 0 a 100), motivo (texto de maximo 20 palabras), bloqueante (texto describiendo un requisito que el candidato no cumple, o null si no hay ninguno).` }] }] }) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 15000
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        912,
        0
      ],
      "id": "737be53b-bf87-439f-a3a7-e77c47932798",
      "name": "HTTP Request1",
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "executeOnce": false,
      "credentials": {
        "googlePalmApi": {
          "id": "flmr2cgdimhL0nia",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const texto = $json.candidates?.[0]?.content?.parts?.[0]?.text ?? '';\nconst id = String($('Code in JavaScript').item.json.id ?? '');\ntry {\n  const limpio = texto.replace(/```json/g, '').replace(/```/g, '').trim();\n  const r = JSON.parse(limpio);\n  if (typeof r.puntaje !== 'number' || r.puntaje < 0 || r.puntaje > 100) {\n    throw new Error('puntaje fuera de rango: ' + r.puntaje);\n  }\n  return {\n    json: {\n      id: id,\n      valido: true,\n      puntaje: r.puntaje,\n      motivo: r.motivo ?? '',\n      bloqueante: r.bloqueante ?? null\n    }\n  };\n} catch (e) {\n  return {\n    json: {\n      id: id,\n      valido: false,\n      puntaje: 0,\n      motivo: 'respuesta invalida del modelo',\n      bloqueante: null,\n      error: e.message,\n      crudo: texto.slice(0, 200)\n    }\n  };\n}"
      },
