    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const texto = $json.output ?? '';\nconst chatId = String($('Code').item.json.chatId ?? '');\nconst nombre = String($('Code').item.json.nombre ?? 'cliente');\ntry {\n  const limpio = texto.replace(/```json/g, '').replace(/```/g, '').trim();\n  const r = JSON.parse(limpio);\n  return { json: { chatId, nombre, valido: true, ...r } };\n} catch (e) {\n  return { json: { chatId, nombre, valido: false, respuesta: 'Disculpa, tuve un problema. ¿Puedes repetir tu mensaje?', error: e.message } };\n}"
      },
      "id": "84f39112-276c-4cac-baf3-4d2377c60498",
